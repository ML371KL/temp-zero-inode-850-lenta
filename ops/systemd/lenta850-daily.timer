[Unit]
Description=Лента 850 · таймер суточного прогона

[Timer]
# Будни 17:25 UTC = 20:25 МСК, после суточного такта 850oa (16:40 UTC, идёт
# ≈25–35 минут). Сессия MOEX закрывается в 18:40 МСК, ISS отдаёт итоги дня; ЦБ
# выкладывает кривую бескупонной доходности тем же вечером; отчёты Ленты выходят
# в 10:00 МСК — раскрытие вечером ловит их в тот же день. В выходные новых
# торговых данных нет, и прогон дал бы тот же выпуск с новой датой (сторож ждёт
# до 74 ч: разрыв пятница → понедельник — 72 ч).
OnCalendar=Mon..Fri *-*-* 17:25:00 UTC
# Разброс, чтобы не бить по ISS ровно в ту же секунду, что соседние панели.
RandomizedDelaySec=300
# Пропущенный из-за выключенной машины прогон догоняется при старте.
Persistent=true
Unit=lenta850-daily.service

[Install]
WantedBy=timers.target
