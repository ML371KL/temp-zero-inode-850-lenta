[Unit]
Description=Лента 850 · таймер утреннего сбора

[Timer]
# Ежедневно 04:20 UTC = 07:20 МСК, после утреннего такта 850oa. Ранний такт
# нужен ради источников без истории (датабук, раскрытие, справочные вакансии,
# описание бумаги): они отдают ТЕКУЩЕЕ состояние, пропущенный день не
# добирается никогда. Час — до рабочего дня, чтобы срез был сопоставим день ко
# дню. По понедельникам такт ещё и гоняет тесты такта «в будущем» (+60 дней).
OnCalendar=*-*-* 04:20:00 UTC
RandomizedDelaySec=300
# Пропущенный из-за выключенной машины прогон догоняется при старте.
Persistent=true
Unit=lenta850-collect.service

[Install]
WantedBy=timers.target
