[Unit]
Description=Лента 850 · таймер проверки нового кода в main (раз в 15 минут)

[Timer]
# Каждые 15 минут со сдвигом на 7-ю минуту: мимо ровных четвертей и пересборки
# 850oa, где сидят соседние панели. Проверка — один анонимный `git fetch` по
# HTTPS, секунды. После правки кода новый выпуск на витрине — через 15–25 минут
# плюс сборка GitHub Pages, а не вечером.
OnCalendar=*:07,22,37,52
RandomizedDelaySec=60
AccuracySec=30s
# Persistent не нужен: пропущенная проверка ничего не теряет — следующая
# увидит тот же новый код.
Unit=lenta850-rebuild.service

[Install]
WantedBy=timers.target
