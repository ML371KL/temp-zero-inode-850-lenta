.venv/
__pycache__/
*.pyc
.pytest_cache/
# Каталог wrangler хранит ID аккаунта Cloudflare и почту — в публичный
# репозиторий он не попадает никогда.
.wrangler/
node_modules/
*.log
# Данные и выходы в git не коммитятся, но сам каталог обязан существовать в
# любой свежей выкладке: pytest.ini уводит временные файлы в var/pytest-tmp,
# а pytest не создаёт родителя basetemp.
/var/*
!/var/.gitkeep
# Выпуски, состояние и выходы: на сервере они живут в $LENTA_STATE_DIR, а
# здесь — только если кто-то собрал руками мимо var/.
payload.json
/release/
/out/
*.sqlite
*.sqlite3
# Песочница переноса с материалами Магнита — только в папке передачи.
port-check/
# Первичка (PDF, XLSX) лежит вне репозитория, в нём — хэши и выписки чисел со
# ссылкой на страницу. Синтетические файлы фикстур тестов — исключение.
*.pdf
*.xlsx
*.xls
*.xlsm
*.docx
!/tests/fixtures/**/*.pdf
!/tests/fixtures/**/*.xlsx
